{
  "manifest_version": 3,
  "name": "SAT Question Bank Practice",
  "version": "1.0.0",
  "description": "Bluebook-style practice layer for the SAT Suite Educator Question Bank: selectable choices, deferred grading, retry-before-rationale.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://qbank-api.collegeboard.org/*"],
  "content_scripts": [
    {
      "matches": [
        "https://satsuitequestionbank.collegeboard.org/*",
        "https://satsuiteeducatorquestionbank.collegeboard.org/*"
      ],
      "js": [
        "content/selectors.js",
        "shared/session.js",
        "content/api.js",
        "content/ui-mc.js",
        "content/ui-spr.js",
        "content/observer.js",
        "content/main.js"
      ],
      "css": ["content/styles.css"],
      "run_at": "document_idle"
    }
  ]
}
